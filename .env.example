# LLM Configuration (OpenAI-compatible endpoint, local or remote)
# For local Ollama: LLM_API_BASE=http://localhost:11434/v1
# For local llama.cpp: LLM_API_BASE=http://localhost:8080/v1
# For vLLM / OpenRouter / Groq / etc: set your base URL and API key
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2
ENABLE_LLM=true

